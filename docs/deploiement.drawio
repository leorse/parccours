<mxfile host="app.diagrams.net">
  <diagram id="parccours-deploiement" name="Déploiement ParcCours (prod / dev)">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ CONTAINERS ============ -->
        <mxCell id="devBox" value="Poste de dev (Windows) — actions manuelles" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;fontStyle=1;fontSize=13;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="380" height="900" as="geometry" />
        </mxCell>
        <mxCell id="prodBox" value="Cloudflare Worker : parccours (PROD)&#10;https://parccours.damien-messner.workers.dev" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#b85450;verticalAlign=top;align=left;fontStyle=1;fontSize=13;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="480" y="220" width="430" height="500" as="geometry" />
        </mxCell>
        <mxCell id="devWorkerBox" value="Cloudflare Worker : parccours-dev (PRÉ-PROD)&#10;https://parccours-dev.damien-messner.workers.dev" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#82b366;verticalAlign=top;align=left;fontStyle=1;fontSize=13;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="960" y="220" width="430" height="500" as="geometry" />
        </mxCell>
        <mxCell id="googleBox" value="Google Cloud Console — OAuth" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#d79b00;verticalAlign=top;align=left;fontStyle=1;fontSize=13;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="480" y="40" width="910" height="150" as="geometry" />
        </mxCell>
        <mxCell id="legendBox" value="Légende" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;fontStyle=1;fontSize=12;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1440" y="600" width="270" height="240" as="geometry" />
        </mxCell>

        <!-- ============ POSTE DE DEV ============ -->
        <mxCell id="sourcecode" value="Code source&#10;src/ · wrangler.jsonc (commité)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="340" height="45" as="geometry" />
        </mxCell>
        <mxCell id="batfiles" value="deploy-dev.bat → node scripts/deploy.js dev&#10;deploy-prod.bat → node scripts/deploy.js prod&#10;push-secrets.bat / push-secrets-dev.bat&#10;preview-local.bat / preview-dev-local.bat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="guard" value="1. Garde-fous (PROD uniquement)&#10;branche = main · working tree propre&#10;git fetch origin main · HEAD == origin/main&#10;code de confirmation à retaper" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="255" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="migrate" value="2. Migrations D1 distantes&#10;wrangler d1 migrations apply &lt;db&gt; --remote&#10;(parccours-db ou parccours-dev --env dev)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="350" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="buildstep" value="3. Build&#10;npx opennextjs-cloudflare build&#10;APP_ENV=&lt;target&gt; injecté au process&#10;→ generateMetadata() fige titre/manifest/icônes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="425" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="deploystep" value="4. Déploiement&#10;npx wrangler deploy&#10;+ --env dev si target=dev" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="510" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="githubmain" value="GitHub — origin/main&#10;(référence pour le garde-fou)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="envfilesProd" value=".dev.vars (secrets PROD, hors git)&#10;AUTH_SECRET · AUTH_GOOGLE_ID/SECRET&#10;ONE_MIN_AI_API_KEY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="680" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="envfilesDev" value=".dev.vars.dev (secrets DEV, hors git)&#10;AUTH_SECRET (≠ prod, sessions étanches)&#10;AUTH_GOOGLE_ID/SECRET + ONE_MIN_AI_API_KEY (partagés)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="760" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pushsecrets" value="node scripts/push-secrets.js [--env dev]&#10;wrangler secret put (un par un, stdin)&#10;à relancer si les secrets disparaissent côté Cloudflare" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="840" width="340" height="70" as="geometry" />
        </mxCell>

