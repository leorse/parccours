        <mxCell id="secretsProd" value="Secrets Cloudflare (chiffrés)&#10;AUTH_SECRET (prod)&#10;AUTH_GOOGLE_ID / SECRET&#10;ONE_MIN_AI_API_KEY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
