{
  "name": "parccours",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "deploy": "node scripts/deploy.js prod",
    "deploy:dev": "node scripts/deploy.js dev",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply parccours-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply parccours-db --remote",
    "db:migrate:dev:local": "wrangler d1 migrations apply parccours-dev --env dev --local",
    "db:migrate:dev:remote": "wrangler d1 migrations apply parccours-dev --env dev --remote",
    "secrets:push": "node scripts/push-secrets.js",
    "secrets:push:dev": "node scripts/push-secrets.js --env dev"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.9",
    "next": "16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "next-pwa": "^5.6.0",
    "react": "^19.1.7",
    "react-dom": "^19.1.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5.7.4",
    "wrangler": "^4.114.0"
  }
}
